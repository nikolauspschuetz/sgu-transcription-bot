# ---------------------------------------------------------------------------
# SGU Transcriber — environment template
#
#   cp .env.template .env      then fill in the blanks for YOUR machine.
#   .env is gitignored; this template is committed. Env vars use the TB_ prefix
#   and override transcription_bot/data/config.toml.
#
# Two reference profiles are documented below. Uncomment ONE and adjust.
# We use ONLY free / local / open-source engines — no paid services.
# ---------------------------------------------------------------------------

TB_LOCAL_MODE=1

# === Backend selection =====================================================
#   transcription_backend: local_whisper (free) | azure (paid — do not use)
#   diarization_backend:   local_pyannote (free) | pyannote_ai (paid — do not use)
#   llm_backend:           none (heuristics only) | ollama (free local) | openai (paid — do not use)
TB_TRANSCRIPTION_BACKEND=local_whisper
TB_DIARIZATION_BACKEND=local_pyannote
TB_LLM_BACKEND=none

# === HuggingFace (free) — needed to download gated pyannote models =========
# Create at https://huggingface.co/settings/tokens and accept the model terms for
# pyannote/speaker-diarization-3.1. Free.
TB_HF_TOKEN=

# ---------------------------------------------------------------------------
# PROFILE A — DEV on this Intel Mac (CPU only, smaller/faster, lower accuracy)
# ---------------------------------------------------------------------------
TB_WHISPER_MODEL=medium.en
TB_WHISPER_DEVICE=cpu
TB_WHISPER_COMPUTE_TYPE=int8
TB_DIARIZATION_DEVICE=cpu
# TB_LLM_BACKEND=none            # no local LLM here; rely on heuristics

# ---------------------------------------------------------------------------
# PROFILE B — GPU BOX (uncomment; full quality)
# ---------------------------------------------------------------------------
# TB_WHISPER_MODEL=large-v3
# TB_WHISPER_DEVICE=cuda
# TB_WHISPER_COMPUTE_TYPE=float16
# TB_DIARIZATION_DEVICE=cuda
# TB_LLM_BACKEND=ollama
# TB_OLLAMA_BASE_URL=http://localhost:11434
# TB_OLLAMA_MODEL=llama3.1

# === Speaker identification (optional) =====================================
# Directory of reference speaker embeddings (built from labeled audio of the
# rogues). Leave blank to skip naming — speakers stay SPEAKER_00.. for review.
TB_VOICEPRINT_DIR=

# === Wiki publishing (optional — leave blank for "output first" dev) ========
# Only needed when you actually publish to sgutranscripts.org.
# Create bot creds at https://www.sgutranscripts.org/wiki/Special:BotPasswords
TB_WIKI_USERNAME=
TB_WIKI_PASSWORD=

# === Legacy paid services (UNUSED — kept blank; do not enable) ==============
